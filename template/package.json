{
  "name": "{{PROJECT_NAME}}",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && printf '_worker.js\\n_routes.json\\n' > dist/.assetsignore",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "astro": "astro",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply {{PROJECT_NAME}} --local",
    "db:migrate:remote": "wrangler d1 migrations apply {{PROJECT_NAME}} --remote",
    "db:seed:local": "wrangler d1 execute {{PROJECT_NAME}} --local --file=./scripts/seed-gifts.sql",
    "db:seed:remote": "wrangler d1 execute {{PROJECT_NAME}} --remote --file=./scripts/seed-gifts.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.0",
    "@clerk/astro": "^2.11.0",
    "astro": "^5.13.0",
    "drizzle-orm": "^0.44.0",
    "qrcode": "^1.5.4",
    "swiper": "^14.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.0",
    "tailwindcss": "^4.1.0",
    "wrangler": "^4.42.0"
  }
}

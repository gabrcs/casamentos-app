---
import '../styles/global.css';
import { UserButton } from '@clerk/astro/components';
import { isAdmin } from '../lib/auth';
import { withBase } from '../lib/url';
import { site } from '../config/site';

interface Props {
  title: string;
}
const { title } = Astro.props;

// O middleware já garante que há usuário logado; aqui checamos a allowlist.
const allowed = await isAdmin(Astro);

const tabs = [
  { href: withBase('/admin'), label: 'Painel' },
  { href: withBase('/admin/rsvps'), label: 'Confirmações' },
  { href: withBase('/admin/presentes'), label: 'Presentes' },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Admin</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[--color-cream]">
    {
      !allowed ? (
        <div class="mx-auto max-w-md px-4 py-24 text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[--color-sand] text-[--color-marsala]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
          </div>
          <h1 class="mt-6 font-display text-4xl text-[--color-marsala-dark]">Acesso restrito</h1>
          <p class="mt-4 text-[--color-ink]/70">
            Esta conta não tem permissão para acessar o painel. Fale com o administrador para
            ser adicionado à lista.
          </p>
          <div class="mt-8 flex justify-center">
            <UserButton />
          </div>
        </div>
      ) : (
        <div class="flex min-h-screen flex-col">
          <header class="sticky top-0 z-20 border-b border-[--color-sand] bg-white/80 backdrop-blur">
            <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
              <a href={withBase('/admin')} class="flex items-baseline gap-2">
                <span class="font-display text-2xl leading-none text-[--color-marsala-dark]">{site.couple.initials}</span>
                <span class="hidden text-[11px] font-medium uppercase tracking-[0.2em] text-[--color-gold] sm:inline">
                  Painel dos noivos
                </span>
              </a>
              <nav class="flex items-center gap-1 rounded-full border border-[--color-sand] bg-[--color-cream] p-1 text-sm">
                {tabs.map((t) => (
                  <a
                    href={t.href}
                    class:list={[
                      'rounded-full px-3.5 py-1.5 transition-colors sm:px-4',
                      path === t.href
                        ? 'bg-[--color-marsala] text-white shadow-sm'
                        : 'text-[--color-ink]/70 hover:bg-[--color-sand] hover:text-[--color-ink]',
                    ]}
                  >
                    {t.label}
                  </a>
                ))}
              </nav>
              <UserButton />
            </div>
          </header>
          <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-10">
            <slot />
          </main>
          <footer class="border-t border-[--color-sand] py-4 text-center text-xs text-[--color-ink]/40">
            {site.couple.short} · Painel administrativo
          </footer>
        </div>
      )
    }
  </body>
</html>

---
import { site } from '../config/site';
import { withBase } from '../lib/url';

// Apenas o essencial para o convidado. As demais seções (vídeo, paleta,
// FAQ, galeria) ficam acessíveis rolando a página.
const links = [
  { href: `${withBase('/')}#casal`, label: 'O Casal' },
  { href: `${withBase('/')}#cerimonia`, label: 'Quando & Onde' },
  { href: `${withBase('/')}#manual`, label: 'Informações' },
  { href: `${withBase('/')}#presentes`, label: 'Presentes' },
];

// Ação principal — destacada no fim do menu.
const rsvpLink = { href: `${withBase('/')}#confirmar`, label: 'Confirmar presença' };
---

<header class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-4 sm:pt-4">
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between gap-4 rounded-2xl border border-sand/70 bg-cream/80 py-2 pl-5 pr-2 shadow-lg shadow-marsala-dark/10 backdrop-blur-md"
  >
    <a href={withBase('/')} class="whitespace-nowrap font-display text-lg text-marsala-dark sm:text-xl">
      {site.couple.short}
    </a>

    <button
      id="nav-toggle"
      class="rounded-lg p-2 text-ink md:hidden"
      aria-label="Abrir menu"
      aria-expanded="false"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="4" y1="7" x2="20" y2="7" />
        <line x1="4" y1="12" x2="20" y2="12" />
        <line x1="4" y1="17" x2="20" y2="17" />
      </svg>
    </button>

    <ul class="hidden items-center gap-5 text-sm md:flex lg:gap-6">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="whitespace-nowrap text-ink transition-colors hover:text-marsala">
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={rsvpLink.href}
          class="whitespace-nowrap rounded-xl bg-marsala px-4 py-2 text-white transition-colors hover:bg-marsala-dark"
        >
          {rsvpLink.label}
        </a>
      </li>
    </ul>
  </nav>

  <ul
    id="nav-menu"
    class="mx-auto mt-2 hidden max-w-5xl rounded-2xl border border-sand/70 bg-cream/95 p-3 text-sm shadow-lg shadow-marsala-dark/10 backdrop-blur-md md:hidden"
  >
    {
      links.map((link) => (
        <li>
          <a href={link.href} class="block rounded-lg px-4 py-2.5 hover:bg-sand">
            {link.label}
          </a>
        </li>
      ))
    }
    <li class="mt-2">
      <a
        href={rsvpLink.href}
        class="block rounded-xl bg-marsala px-4 py-2.5 text-center text-white hover:bg-marsala-dark"
      >
        {rsvpLink.label}
      </a>
    </li>
  </ul>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(open === false));
  });
  // Links dentro do menu mobile rolam a página (não navegam), então o menu
  // precisa ser fechado manualmente ao clicar.
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

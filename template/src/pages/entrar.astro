---
import Base from '../layouts/Base.astro';
import { SignIn } from '@clerk/astro/components';
import { withBase } from '../lib/url';

export const prerender = false;
---

<Base title="Entrar">
  <section class="mx-auto flex max-w-md flex-col items-center px-4 py-16">
    <h1 class="mb-8 font-display text-4xl text-[--color-sage-dark]">Área dos noivos</h1>
    <SignIn signUpUrl={withBase('/entrar')} forceRedirectUrl={withBase('/admin')} />
  </section>
</Base>

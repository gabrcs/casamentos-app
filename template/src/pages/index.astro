---
import Base from '../layouts/Base.astro';
import type { ImageMetadata } from 'astro';
import Countdown from '../components/Countdown.astro';
import GiftCard from '../components/GiftCard.astro';
import { site } from '../config/site';
import { withBase } from '../lib/url';
import { getDb } from '../db/client';
import { gifts as giftsTable } from '../db/schema';
import { buildPix } from '../lib/pix';
import { asc } from 'drizzle-orm';

export const prerender = false;

const eventDate = new Date(site.eventDate);
const dateLabel = eventDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

// Manual dos convidados — tópicos do site antigo (iCasei).
// Pendentes de conteúdo do casal (estavam vazios no site antigo):
// Estacionamento, Aplicativos, Crianças, Hotéis próximos, Uber, Táxi, Tempo previsto.
// Ícones de linha fina (stroke) no tom marsala — coerentes com o serif do site.
const manualIcon = (paths: string) =>
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto h-9 w-9" aria-hidden="true">${paths}</svg>`;

const guestManual = [
  {
    // Cabide de roupa
    icon: manualIcon(
      '<path d="M12 6a2 2 0 1 0-2-2"/><path d="M12 6 3.7 12.2a1.6 1.6 0 0 0 1 2.8h14.6a1.6 1.6 0 0 0 1-2.8L12 6z"/>'
    ),
    title: 'Dress Code',
    text: 'Traje: Passeio Completo. Confira logo abaixo a paleta de cores dos convidados.',
  },
  {
    // Relógio
    icon: manualIcon('<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>'),
    title: 'Pontualidade',
    text: `A cerimônia começará pontualmente às ${site.ceremony.time}. Chegue com antecedência.`,
  },
  {
    // Celular cortado
    icon: manualIcon(
      '<rect x="8" y="3" width="8" height="18" rx="2"/><path d="M11 18h2"/><path d="M4.5 4.5l15 15"/>'
    ),
    title: 'Fotos',
    text: 'Durante a cerimônia, deixe o celular guardado. Nossos fotógrafos registrarão tudo!',
  },
  {
    // Igreja
    icon: manualIcon(
      '<path d="M12 3v4M10 5h4"/><path d="M12 7l-6 5v9h12v-9l-6-5z"/><path d="M10 21v-3.5a2 2 0 1 1 4 0V21"/>'
    ),
    title: 'Cerimônia',
    text: `${site.ceremony.place} - ${site.ceremony.address}.`,
  },
  {
    // Taça de vinho
    icon: manualIcon(
      '<path d="M7.5 3h9l-.6 4.6a3.9 3.9 0 0 1-7.8 0L7.5 3z"/><path d="M12 11.5V19M8.5 21h7"/>'
    ),
    title: 'Recepção',
    text: `${site.reception.place} - logo após a cerimônia.`,
  },
  {
    // Envelope
    icon: manualIcon(
      '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3.5 7.5 12 13l8.5-5.5"/>'
    ),
    title: 'Confirmação',
    text: `Confirme sua presença até ${site.rsvpDeadline} pelo formulário no fim da página.`,
  },
];

// Paleta dos Convidados — do site antigo (iCasei). `hex` é aproximado (para
// o quadradinho ilustrativo); null quando o nome não define uma cor exata.
const paletteAvoid = [
  { name: 'Marsala', hex: '#955251' },
  { name: 'Terracota', hex: '#C1440E' },
  { name: 'Tons escolhidos para os padrinhos', hex: null },
  { name: 'Branco', hex: '#FFFFFF' },
  { name: 'Off White', hex: '#F5F0E6' },
  { name: 'Marfim', hex: '#FFFFF0' },
  { name: 'Champanhe', hex: '#F7E7CE' },
  { name: 'Nude muito claro', hex: '#EAD3BF' },
  { name: 'Prata muito claro', hex: '#E4E4E4' },
];
const paletteSuggest = [
  { name: 'Azul Marinho', hex: '#1B2A4A' },
  { name: 'Azul Petróleo', hex: '#1F4E5F' },
  { name: 'Verde Esmeralda', hex: '#0F6B4C' },
  { name: 'Fendi', hex: '#A0876B' },
  { name: 'Grafite', hex: '#4B4B4B' },
  { name: 'Rosê Queimado', hex: '#B76E79' },
  { name: 'Lavanda', hex: '#B99CD1' },
  { name: 'Ameixa', hex: '#7C3F61' },
  { name: 'Azul Serenity', hex: '#92A8D1' },
  { name: 'Cinza Médio', hex: '#808080' },
  { name: 'Preto', hex: '#000000' },
];

// Programação do dia — EXEMPLO editável. Ajuste horários e itens para o
// cronograma real do casal antes do envio dos convites.
const schedule = [
  { time: '17h30', title: 'Recepção dos convidados' },
  { time: '18h00', title: 'Cerimônia' },
  { time: '19h15', title: 'Sessão de fotos' },
  { time: '20h00', title: `Recepção em ${site.reception.place}` },
  { time: '20h30', title: 'Jantar' },
  { time: '22h00', title: 'Bolo e docinhos' },
  { time: '22h30', title: 'Festa' },
  { time: '00h00', title: 'Hora de descansar' },
];

// FAQ — perguntas do site antigo; respostas pendentes do casal.
const faq = [
  'Posso levar crianças?',
  'Posso usar vestido curto?',
  'Haverá estacionamento?',
  'Qual traje?',
  'Posso confirmar mais de um convidado?',
  'Posso chegar após o início?',
  'Há hotéis próximos?',
  'Posso tirar fotos durante a cerimônia?',
].map((q) => ({ q, a: 'Resposta em definição - em breve atualizaremos aqui.' }));

// Galeria dinâmica: toda imagem em src/assets/galeria aparece automaticamente.
const galleryModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/galeria/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
  { eager: true }
);
const galleryPhotos = Object.entries(galleryModules)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, mod], i) => ({
    src: mod.default.src,
    label: `Foto ${i + 1} da galeria de ${site.couple.short}`,
  }));

const env = Astro.locals.runtime.env;
const pixKey = env.PIX_KEY ?? '';
const merchantName = env.PIX_MERCHANT_NAME ?? 'CASAMENTO';
const merchantCity = env.PIX_MERCHANT_CITY ?? 'SAO PAULO';

let gifts: Awaited<ReturnType<typeof loadGifts>> = [];
let dbError = false;

async function loadGifts() {
  const db = getDb(Astro);
  return db
    .select()
    .from(giftsTable)
    .orderBy(asc(giftsTable.sortOrder), asc(giftsTable.id));
}

try {
  gifts = await loadGifts();
} catch (err) {
  console.error('Erro ao carregar presentes', err);
  dbError = true;
}

// Gera o Pix apenas para itens disponíveis e quando há chave configurada.
const cards = await Promise.all(
  gifts.map(async (gift) => {
    if (gift.status !== 'available' || !pixKey) {
      return { gift, copyPaste: null, qrSvg: null };
    }
    const { copyPaste, qrSvg } = await buildPix({
      key: pixKey,
      merchantName,
      merchantCity,
      amountCents: gift.priceCents,
      txid: `PRESENTE${gift.id}`,
    });
    return { gift, copyPaste, qrSvg };
  })
);

// Mais baratos primeiro; só os 3 primeiros aparecem de início.
cards.sort((a, b) => a.gift.priceCents - b.gift.priceCents);
const VISIBLE_GIFTS = 3;

const erro = Astro.url.searchParams.get('erro');
const erroMsg =
  erro === 'codigo'
    ? 'Por favor, informe o código do convite.'
    : erro === 'nome'
      ? 'Por favor, informe seu nome.'
      : erro === 'servidor'
        ? 'Ocorreu um erro ao salvar. Tente novamente.'
        : null;
---

<Base fullBleed>
  <!-- Banner com foto dos noivos -->
  <section id="inicio" class="relative scroll-mt-28 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-marsala-dark via-marsala to-[#4a2426]">
      <div id="banner-slider" class="relative h-full w-full">
        {
          [
            { src: '/images/noivos.jpg', position: 'center' },
            { src: '/images/noivos-02.jpg', position: 'center' },
            { src: '/images/noivos-03.jpg', position: 'center' },
            { src: '/images/noivos-04.jpg', position: '62% center' },
            { src: '/images/noivos-05.jpg', position: '40% center' },
          ].map(({ src, position }, i) => (
            <img
              src={withBase(src)}
              alt={`${site.couple.short} — foto de capa`}
              class="banner-slide absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 ease-in-out"
              style={`opacity: ${i === 0 ? 1 : 0}; object-position: ${position};`}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
            />
          ))
        }
      </div>
    </div>
    <div class="absolute inset-0 bg-black/35"></div>

    <div class="relative mx-auto flex min-h-[92vh] max-w-3xl flex-col items-center justify-center px-4 pt-32 pb-52 text-center">
      <div class="absolute inset-x-0 top-24 px-4">
        <p class="hero-text">
          Você está convidado para o nosso casamento
        </p>
      </div>

      <h1 class="font-display italic text-6xl sm:text-8xl leading-tight text-white">
        {site.couple.groom}
        <span class="block text-4xl sm:text-5xl not-italic my-2">&</span>
        {site.couple.bride}
      </h1>

      <div class="absolute inset-x-0 bottom-32 px-4">
        <p class="hero-text">
          “{site.quote}”
        </p>

        <p class="hero-text">
          {dateLabel} · {site.ceremony.time} · {site.city}
        </p>
      </div>

      <div class="absolute inset-x-0 bottom-8 flex justify-center px-4">
        <Countdown date={site.eventDate} tone="light" />
      </div>
    </div>
  </section>

  <!-- Mensagem de boas-vindas -->
  <section id="boas-vindas" class="scroll-mt-28">
    <div class="mx-auto max-w-3xl px-4 py-20 text-center">
      <p class="uppercase tracking-[0.3em] text-sm text-marsala">Sejam bem-vindos</p>
      <h2 class="mt-6 font-display text-4xl sm:text-5xl text-marsala-dark">
        O amor nos trouxe até aqui
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink/80">
        Com o coração cheio de alegria, convidamos você para celebrar conosco o dia mais
        especial das nossas vidas. Preparamos este espaço com todas as informações para que
        você aproveite cada momento ao nosso lado.
      </p>
    </div>
  </section>

  <!-- Sobre o casal -->
  <section id="casal" class="scroll-mt-28 border-t border-sand bg-white/40">
    <div class="mx-auto max-w-5xl px-4 py-20">
      <h2 class="text-center font-display text-4xl sm:text-5xl text-marsala-dark">Sobre o Casal</h2>

      <div class="mt-12 grid gap-10 md:grid-cols-2 md:items-stretch">
        <div class="md:relative">
          <img
            src={withBase('/images/casal.jpg')}
            alt={`${site.couple.short} sorrindo um para o outro`}
            class="h-auto w-full rounded-2xl md:absolute md:inset-0 md:h-full md:object-cover md:object-bottom"
            loading="lazy"
          />
        </div>

        <div>
          <h3 class="font-display text-3xl text-marsala">Nossa história</h3>
          {
            site.story.map((paragraph) => (
              <p class="mt-4 leading-relaxed text-ink/80">{paragraph}</p>
            ))
          }
          <p class="mt-4 leading-relaxed text-ink/80">
            Com carinho,<br />
            <span class="font-display italic text-lg text-marsala-dark">
              {site.couple.groom} & {site.couple.bride}
            </span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Vídeo do ensaio (só aparece se site.videoUrl estiver preenchido) -->
  {
    site.videoUrl && (
      <section id="video" class="scroll-mt-28 border-t border-sand">
        <div class="mx-auto max-w-4xl px-4 py-20 text-center">
          <h2 class="font-display text-4xl sm:text-5xl text-marsala-dark">
            Assista ao clipe do nosso ensaio
          </h2>
          <p class="mt-4 text-ink/70">Um pedacinho do nosso pré-wedding.</p>

          {/* Facade: thumbnail própria + play em marsala; o iframe do YouTube só
              carrega no clique (mantém a paleta e acelera o carregamento). */}
          <div class="mt-10 overflow-hidden rounded-2xl border border-sand">
            <button
              type="button"
              id="video-facade"
              class="group relative block aspect-video w-full cursor-pointer"
              aria-label="Assistir ao clipe do ensaio"
            >
              <img
                src={withBase('/images/noivos-05.jpg')}
                alt={`${site.couple.short} — pré-wedding`}
                class="absolute inset-0 h-full w-full object-cover"
                loading="lazy"
              />
              <span class="absolute inset-0 bg-gradient-to-t from-marsala-dark/70 via-black/10 to-transparent" />
              <span class="absolute inset-0 flex items-center justify-center">
                <span class="flex h-16 w-16 items-center justify-center rounded-full bg-cream/95 shadow-lg transition-transform duration-300 group-hover:scale-110 sm:h-20 sm:w-20">
                  <svg
                    class="h-7 w-7 text-marsala sm:h-8 sm:w-8"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M8 5.3v13.4a.5.5 0 0 0 .76.43l11-6.7a.5.5 0 0 0 0-.86l-11-6.7a.5.5 0 0 0-.76.43z" />
                  </svg>
                </span>
              </span>
              <span class="absolute inset-x-0 bottom-5 text-center text-xs uppercase tracking-[0.3em] text-cream sm:text-sm">
                {site.couple.short}
              </span>
            </button>
            <iframe
              data-src={`${site.videoUrl}?autoplay=1`}
              title={`Clipe do ensaio — ${site.couple.short}`}
              class="hidden aspect-video w-full"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            />
          </div>
        </div>
      </section>
    )
  }

  <!-- Cerimônia -->
  <section id="cerimonia" class="scroll-mt-28 border-t border-sand bg-white/40">
    <div class="mx-auto max-w-5xl px-4 py-20">
      <h2 class="text-center font-display text-4xl sm:text-5xl text-marsala-dark">
        {site.ceremony.title}
      </h2>

      <div class="mt-12 grid items-center gap-10 md:grid-cols-2">
        <div class="text-center md:text-left">
          <p class="text-3xl text-marsala">{dateLabel}</p>
          <p class="mt-2 text-xl text-marsala">às {site.ceremony.time}</p>
          <p class="mt-6 text-lg font-medium">{site.ceremony.place}</p>
          <p class="mt-1 text-ink/70">{site.ceremony.address}</p>
          <a href={site.ceremony.mapsUrl} target="_blank" rel="noopener" class="btn-outline mt-6">
            Abrir no Google Maps
          </a>
        </div>

        <iframe
          src={site.ceremony.mapsEmbedUrl}
          title={`Mapa — ${site.ceremony.place}`}
          class="h-72 w-full rounded-2xl border border-sand"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <!-- Festa -->
  <section id="festa" class="scroll-mt-28 border-t border-sand">
    <div class="mx-auto max-w-5xl px-4 py-20">
      <h2 class="text-center font-display text-4xl sm:text-5xl text-marsala-dark">
        {site.reception.title}
      </h2>

      <div class="mt-12 grid items-center gap-10 md:grid-cols-2">
        <iframe
          src={site.reception.mapsEmbedUrl}
          title={`Mapa — ${site.reception.place}`}
          class="order-2 md:order-1 h-72 w-full rounded-2xl border border-sand"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>

        <div class="order-1 md:order-2 text-center md:text-left">
          <p class="text-3xl text-marsala">{dateLabel}</p>
          <p class="mt-2 text-xl text-marsala">{site.reception.time}</p>
          <p class="mt-6 text-lg font-medium">{site.reception.place}</p>
          <p class="mt-1 text-ink/70">{site.reception.address}</p>
          <a href={site.reception.mapsUrl} target="_blank" rel="noopener" class="btn-outline mt-6">
            Abrir no Google Maps
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Manual dos convidados -->
  <section id="manual" class="scroll-mt-28 border-t border-marsala-dark bg-marsala">
    <div class="mx-auto max-w-5xl px-4 py-20">
      <h2 class="text-center font-display text-4xl sm:text-5xl text-cream">
        Manual dos Convidados
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-center text-cream/85">
        Algumas orientações para que todos aproveitem o grande dia.
      </p>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          guestManual.map((item) => (
            <div class="rounded-2xl border border-marsala-dark/30 bg-cream p-6 text-center">
              <div class="text-marsala" set:html={item.icon} />
              <h3 class="mt-3 font-display text-2xl text-marsala">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/75">{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Paleta dos Convidados -->
  <section id="paleta" class="scroll-mt-28 border-t border-sand">
    <div class="mx-auto max-w-4xl px-4 py-20">
      <h2 class="text-center font-display text-4xl sm:text-5xl text-marsala-dark">
        Paleta dos Convidados
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-center text-ink/70">
        Traje: <strong>Passeio Completo</strong>. Solicitamos gentilmente que não sejam
        utilizadas as cores reservadas às madrinhas e padrinhos, para manter a harmonia da
        cerimônia.
      </p>

      <div class="mt-12 grid gap-8 sm:grid-cols-2">
        <div class="rounded-2xl border border-sand bg-white/60 p-8">
          <h3 class="font-display text-2xl text-marsala">Por favor, evitar</h3>
          <ul class="mt-5 flex flex-wrap gap-2">
            {
              paletteAvoid.map((color) => (
                <li class="flex items-center gap-2 rounded-full border border-marsala/30 bg-sand/50 py-1.5 pl-2 pr-4 text-sm text-ink/80">
                  {color.hex ? (
                    <span
                      class="h-4 w-4 shrink-0 rounded-md border border-ink/15"
                      style={`background-color:${color.hex}`}
                    />
                  ) : (
                    <span class="shrink-0">✕</span>
                  )}
                  {color.name}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rounded-2xl border border-sand bg-white/60 p-8">
          <h3 class="font-display text-2xl text-marsala">Sugestões elegantes</h3>
          <ul class="mt-5 flex flex-wrap gap-2">
            {
              paletteSuggest.map((color) => (
                <li class="flex items-center gap-2 rounded-full border border-marsala/30 py-1.5 pl-2 pr-4 text-sm text-ink/80">
                  {color.hex ? (
                    <span
                      class="h-4 w-4 shrink-0 rounded-md border border-ink/15"
                      style={`background-color:${color.hex}`}
                    />
                  ) : (
                    <span class="shrink-0">✓</span>
                  )}
                  {color.name}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Cronograma -->
  <section id="cronograma" class="scroll-mt-28 border-t border-sand bg-white/40">
    <div class="mx-auto max-w-2xl px-4 py-20">
      <p class="text-center uppercase tracking-[0.3em] text-sm text-marsala">Programação do dia</p>
      <h2 class="mt-4 text-center font-display text-4xl sm:text-5xl text-marsala-dark">
        Como será <em>o nosso dia</em>
      </h2>

      <ol class="mx-auto mt-14 max-w-md">
        {
          schedule.map((item) => (
            <li class="group grid grid-cols-[5rem_auto_1fr] items-start gap-x-5">
              <p class="text-right font-display italic text-2xl leading-none text-marsala">{item.time}</p>
              <div class="flex h-full flex-col items-center">
                <span class="mt-1.5 h-3 w-3 shrink-0 rounded-full border-2 border-marsala bg-cream" />
                <span class="w-px flex-1 bg-marsala/30 group-last:hidden" />
              </div>
              <p class="pt-0.5 pb-12 text-sm uppercase tracking-[0.2em] text-ink/80 group-last:pb-0">
                {item.title}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Presentes -->
  <section id="presentes" class="scroll-mt-28 border-t border-sand bg-white/40">
    <div class="mx-auto max-w-6xl px-4 py-20">
      <h2 class="text-center font-display text-4xl sm:text-5xl text-marsala-dark">Lista de Presentes</h2>
      <p class="mx-auto mt-4 max-w-2xl text-center text-ink/70">
        O maior presente será celebrar esse momento ao lado das pessoas que amamos. Caso
        desejem nos presentear, preparamos nossa lista com muito carinho - a contribuição é
        via Pix, rápida e sem taxas.
      </p>

      {
        dbError && (
          <p class="mx-auto mt-8 max-w-lg rounded-lg bg-yellow-100 px-4 py-3 text-center text-sm text-yellow-800">
            Não foi possível carregar a lista agora. Tente novamente em instantes.
          </p>
        )
      }

      {
        !dbError && cards.length === 0 && (
          <p class="mt-12 text-center text-ink/60">
            A lista de presentes ainda está sendo preparada. Volte em breve ❤️
          </p>
        )
      }

      {
        !pixKey && cards.length > 0 && (
          <p class="mx-auto mt-8 max-w-lg rounded-lg bg-yellow-100 px-4 py-3 text-center text-sm text-yellow-800">
            Chave Pix ainda não configurada (defina o secret <code>PIX_KEY</code>).
          </p>
        )
      }

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          cards.map((c, i) => (
            <div
              class:list={[
                'grid',
                i === 1 && 'gift-extra hidden sm:grid',
                i === 2 && 'gift-extra hidden lg:grid',
                i >= VISIBLE_GIFTS && 'gift-extra hidden',
              ]}
            >
              <GiftCard gift={c.gift} copyPaste={c.copyPaste} qrSvg={c.qrSvg} />
            </div>
          ))
        }
      </div>

      {
        cards.length > VISIBLE_GIFTS && (
          <div class="mt-10 text-center">
            <button type="button" id="gifts-toggle" class="btn-outline">
              Mostrar mais presentes ({cards.length - VISIBLE_GIFTS})
            </button>
          </div>
        )
      }
    </div>
  </section>

  <!-- Confirmar Presença -->
  <section id="confirmar" class="scroll-mt-28 border-t border-sand">
    <div class="mx-auto max-w-xl px-4 py-20">
      <h2 class="text-center font-display text-4xl sm:text-5xl text-marsala-dark">Confirmação de Presença</h2>
      <p class="mt-4 text-center text-ink/70">
        Por favor, confirme até <strong>{site.rsvpDeadline}</strong>.
      </p>

      {
        erroMsg && (
          <p class="mt-6 rounded-lg bg-red-100 px-4 py-3 text-center text-sm text-red-800">
            {erroMsg}
          </p>
        )
      }

      <form method="POST" action={withBase('/api/rsvp')} class="uv-form mx-auto mt-8 w-full max-w-md">
        <p class="uv-title">Confirme sua presença</p>
        <p class="uv-msg">Preencha os campos abaixo para nos avisar se poderá comparecer.</p>

        <label class="uv-field">
          <input id="invite_code" name="invite_code" required placeholder=" " class="uv-input" />
          <span>Código do convite *</span>
        </label>

        <label class="uv-field">
          <input id="name" name="name" required placeholder=" " class="uv-input" />
          <span>Seu nome *</span>
        </label>

        <fieldset class="uv-fieldset">
          <legend class="uv-legend">Confirmação *</legend>
          <div class="uv-check-group">
            {
              [
                { value: 'yes', label: 'Sim, irei comparecer' },
                { value: 'maybe', label: 'Talvez, ainda irei confirmar' },
                { value: 'no', label: 'Não, infelizmente não irei' },
              ].map((opt) => (
                <div class="uv-check">
                  <input
                    type="radio"
                    name="status"
                    value={opt.value}
                    id={`status-${opt.value}`}
                    required
                  />
                  <label for={`status-${opt.value}`} class="uv-check-label">
                    <svg width="34" height="34" viewBox="0 0 95 95">
                      <rect x="30" y="20" width="50" height="50" fill="none" />
                      <g transform="translate(0,-952.36222)">
                        <path
                          d="m 56,963 c -102,122 6,9 7,9 17,-5 -66,69 -38,52 122,-77 -7,14 18,4 29,-11 45,-43 23,-4"
                          stroke-width="3"
                          fill="none"
                          class="path1"
                        />
                      </g>
                    </svg>
                    <span>{opt.label}</span>
                  </label>
                </div>
              ))
            }
          </div>
        </fieldset>

        <label class="uv-field">
          <textarea id="message" name="message" rows="3" placeholder=" " class="uv-input"></textarea>
          <span>Mensagem, comentário ou perguntas</span>
        </label>

        <button type="submit" class="uv-submit">Enviar confirmação</button>
      </form>
    </div>
  </section>

  <!-- Informações e Dúvidas (FAQ) -->
  <section id="faq" class="scroll-mt-28 border-t border-sand bg-white/40">
    <div class="mx-auto max-w-3xl px-4 py-20">
      <h2 class="text-center font-display text-4xl sm:text-5xl text-marsala-dark">
        Informações e Dúvidas
      </h2>
      <p class="mt-4 text-center text-ink/70">Perguntas frequentes dos convidados.</p>

      <div class="mt-12 space-y-3">
        {
          faq.map((item) => (
            <details class="group rounded-2xl border border-sand bg-white/60 px-6 py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-marsala-dark">
                {item.q}
                <span class="text-marsala transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-sm italic text-ink/50">{item.a}</p>
            </details>
          ))
        }
      </div>

      <!-- Quando o casal definir o canal de contato (e-mail/WhatsApp), adicionar aqui:
           "Ainda ficou com alguma dúvida? Fale com a gente." -->
    </div>
  </section>

  <!-- Galeria de fotos (carrossel Swiper) -->
  <section id="galeria" class="scroll-mt-28 border-t border-sand">
    <div class="gallery">
      <div class="responsive-container-block bg">
        <div class="responsive-container-block">
          <p class="text-blk title font-display">Galeria de Fotos</p>
          <p class="text-blk heading">Alguns dos nossos momentos favoritos.</p>
        </div>
        <div class="swiper swiper-container mySwiper">
          <div class="swiper-wrapper">
            {
              galleryPhotos.map((photo) => (
                <div class="swiper-slide">
                  <img class="im" src={photo.src} alt={photo.label} loading="lazy" />
                </div>
              ))
            }
          </div>
          <div class="swiper-pagination container-block"></div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const videoFacade = document.getElementById('video-facade');
  videoFacade?.addEventListener('click', () => {
    const iframe = videoFacade.nextElementSibling as HTMLIFrameElement | null;
    if (!iframe) return;
    iframe.src = iframe.dataset.src ?? '';
    iframe.classList.remove('hidden');
    videoFacade.remove();
  });
</script>

<script>
  import Swiper from 'swiper';
  import { Pagination, Autoplay } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/pagination';

  new Swiper('.gallery .mySwiper', {
    modules: [Pagination, Autoplay],
    slidesPerView: 3,
    spaceBetween: 30,
    loop: true,
    autoplay: {
      delay: 3500,
      pauseOnMouseEnter: true,
    },
    pagination: {
      el: '.gallery .swiper-pagination',
      clickable: true,
    },
    breakpoints: {
      200: {
        slidesPerView: 1,
      },
      501: {
        slidesPerView: 1.5,
      },
      769: {
        slidesPerView: 2.5,
        spaceBetween: 10,
      },
      1025: {
        slidesPerView: 3,
        spaceBetween: 20,
      },
    },
  });
</script>

<script>
  const bannerSlides = document.querySelectorAll<HTMLImageElement>('#banner-slider .banner-slide');
  if (bannerSlides.length > 1) {
    let currentSlide = 0;
    setInterval(() => {
      const next = (currentSlide + 1) % bannerSlides.length;
      bannerSlides[currentSlide].style.opacity = '0';
      bannerSlides[next].style.opacity = '1';
      currentSlide = next;
    }, 5000);
  }
</script>

<script>
  const giftsToggle = document.getElementById('gifts-toggle');
  const extraGifts = document.querySelectorAll('.gift-extra');
  let giftsExpanded = false;

  const totalGifts = document.querySelectorAll('.gift-card').length;

  function visibleGiftCount() {
    // i=0 sempre; i=1 em >=640px (sm); i=2 em >=1024px (lg)
    let visible = 1;
    if (window.matchMedia('(min-width: 640px)').matches) visible += 1;
    if (window.matchMedia('(min-width: 1024px)').matches) visible += 1;
    return Math.min(visible, totalGifts);
  }

  function updateGiftsLabel() {
    if (!giftsToggle) return;
    if (giftsExpanded) {
      giftsToggle.textContent = 'Mostrar menos';
      return;
    }
    const hiddenCount = Math.max(totalGifts - visibleGiftCount(), 0);
    giftsToggle.textContent = `Mostrar mais presentes (${hiddenCount})`;
  }

  giftsToggle?.addEventListener('click', () => {
    giftsExpanded = !giftsExpanded;
    extraGifts.forEach((el) => el.classList.toggle('hidden', !giftsExpanded));
    updateGiftsLabel();
  });
  window.addEventListener('resize', updateGiftsLabel);
  updateGiftsLabel();
</script>

<script>
  document.querySelectorAll('.gift-card').forEach((card) => {
    const toggle = card.querySelector<HTMLButtonElement>('.pix-toggle');
    const panel = card.querySelector<HTMLElement>('.pix-panel');
    const copyBtn = card.querySelector<HTMLButtonElement>('.pix-copy');
    const code = card.querySelector<HTMLInputElement>('.pix-code');

    toggle?.addEventListener('click', () => panel?.classList.toggle('hidden'));

    copyBtn?.addEventListener('click', async () => {
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code.value);
      } catch {
        code.select();
        document.execCommand('copy');
      }
      const original = copyBtn.textContent;
      copyBtn.textContent = 'Copiado!';
      setTimeout(() => (copyBtn.textContent = original), 2000);
    });
  });
</script>


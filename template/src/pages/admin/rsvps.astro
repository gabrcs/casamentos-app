---
import Admin from '../../layouts/Admin.astro';
import { getDb } from '../../db/client';
import { rsvps } from '../../db/schema';
import { isAdmin } from '../../lib/auth';
import { withBase } from '../../lib/url';
import { desc } from 'drizzle-orm';
import type { Rsvp } from '../../db/schema';

export const prerender = false;

let rows: Rsvp[] = [];
if (await isAdmin(Astro)) {
  const db = getDb(Astro);
  rows = await db.select().from(rsvps).orderBy(desc(rsvps.createdAt));
}

const statusBadge = {
  yes: { label: 'Sim', class: 'bg-emerald-50 text-emerald-700 ring-emerald-200' },
  maybe: { label: 'Talvez', class: 'bg-amber-50 text-amber-700 ring-amber-200' },
  no: { label: 'Não', class: 'bg-rose-50 text-rose-700 ring-rose-200' },
} as const;
---

<Admin title="Confirmações">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-[11px] font-medium uppercase tracking-[0.25em] text-[--color-gold]">RSVP</p>
      <h1 class="mt-1 font-display text-4xl text-[--color-marsala-dark]">
        Confirmações
        <span class="ml-1 align-middle rounded-full bg-[--color-sand] px-3 py-1 font-sans text-sm font-medium text-[--color-marsala-dark]">
          {rows.length}
        </span>
      </h1>
    </div>
    <a href={withBase('/api/rsvps/export')} class="btn-outline">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
      </svg>
      Exportar CSV
    </a>
  </div>

  <div class="mt-8 overflow-x-auto rounded-2xl border border-[--color-sand] bg-white shadow-[0_4px_16px_rgba(111,58,60,0.06)]">
    <table class="w-full text-sm">
      <thead class="border-b border-[--color-sand] bg-[--color-cream] text-left text-xs font-medium uppercase tracking-wider text-[--color-ink]/50">
        <tr>
          <th class="px-4 py-3">Código do convite</th>
          <th class="px-4 py-3">Nome</th>
          <th class="px-4 py-3">Confirmação</th>
          <th class="px-4 py-3">Mensagem</th>
          <th class="px-4 py-3">Data</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[--color-sand]/70">
        {
          rows.length === 0 ? (
            <tr>
              <td colspan="5" class="px-4 py-16 text-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-8 w-8 text-[--color-ink]/25" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
                <p class="mt-3 text-[--color-ink]/50">Nenhuma confirmação ainda.</p>
              </td>
            </tr>
          ) : (
            rows.map((r) => (
              <tr class="transition-colors hover:bg-[--color-cream]/60">
                <td class="px-4 py-3">
                  <code class="rounded bg-[--color-sand]/60 px-2 py-0.5 text-xs text-[--color-marsala-dark]">
                    {r.inviteCode}
                  </code>
                </td>
                <td class="px-4 py-3 font-medium">{r.name}</td>
                <td class="px-4 py-3">
                  <span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset ${statusBadge[r.status as keyof typeof statusBadge]?.class ?? ''}`}>
                    {statusBadge[r.status as keyof typeof statusBadge]?.label ?? r.status}
                  </span>
                </td>
                <td class="px-4 py-3 max-w-[16rem] text-[--color-ink]/70">{r.message}</td>
                <td class="px-4 py-3 whitespace-nowrap text-[--color-ink]/60">{r.createdAt}</td>
              </tr>
            ))
          )
        }
      </tbody>
    </table>
  </div>
</Admin>
